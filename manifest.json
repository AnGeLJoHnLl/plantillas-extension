{
  "manifest_version": 3,
  "name": "HITSS Tickets & OCR — Asistente Laraigo",
  "version": "1.0.0",
  "description": "Generador de plantillas técnicas SOT, herramientas y escáner OCR integrado directamente sobre Laraigo.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir HITSS Tickets"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.laraigo.com/*",
    "https://claro.laraigo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.laraigo.com/*",
        "https://claro.laraigo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "styles.css",
        "app.js",
        "ocr-extension.js",
        "extension-bootstrap.js",
        "cropper.min.js",
        "cropper.min.css",
        "icons/*",
        "*.png",
        "*.gif",
        "*.webp",
        "*.wav",
        "*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
